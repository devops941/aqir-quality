# ============================================================
# Docker build context exclusions
# ============================================================

# Version control
.git
.gitignore

# Python virtual environments
.venv
venv
env

# Python cache files
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist
build
.eggs

# Pytest cache
.pytest_cache
.coverage
htmlcov

# Editor / IDE
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Database (let the container build its own from synthetic data,
# or mount an external one at runtime)
data/aqi.db

# Pre-trained models (let the container retrain, or mount at runtime)
models/*.joblib

# Generated report outputs (re-generated by the container)
outputs/report.md
outputs/report.html
outputs/report.pdf
outputs/fig_*.png
outputs/*.png

# Notebooks (not needed in the runtime image)
notebooks/

# Documentation PDFs
*.pdf

# Windows-specific junk directories (artefact from prior runs)
Dpython_projectsair_quality_checkfrontendcss
Dpython_projectsair_quality_checkfrontendjs
